+        #expect(cell.attribute.bg == .trueColor(red: UInt8(255 - (last >> 16)),
+                                              green: UInt8(255 - ((last >> 8) & 255)),
+                                              blue: UInt8(255 - (last & 255))))
+        #expect(terminal.currentAttribute == cell.attribute)
