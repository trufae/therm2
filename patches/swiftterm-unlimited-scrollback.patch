diff --git a/Tests/SwiftTermTests/UnlimitedScrollbackTests.swift b/Tests/SwiftTermTests/UnlimitedScrollbackTests.swift
new file mode 100644
index 0000000..d074bb1
--- /dev/null
+++ b/Tests/SwiftTermTests/UnlimitedScrollbackTests.swift
@@ -0,0 +1,28 @@
+import Testing
+@testable import SwiftTerm
+
+struct UnlimitedScrollbackTests {
+    @Test(arguments: [false, true]) func clearingHistoryReleasesRows(eraseSavedLines: Bool) {
+        let (terminal, _) = TerminalTestHarness.makeTerminal(cols: 20, rows: 4, scrollback: -1)
+        terminal.feed(text: String(repeating: "history\r\n", count: 2_000) + "visible")
+        let buffer = terminal.normalBuffer
+        weak var oldestRow = buffer.lines[0]
+        #expect(buffer.lines.count > terminal.rows)
+        #expect(oldestRow != nil)
+
+        if eraseSavedLines {
+            terminal.feed(text: "\u{1b}[3J")
+        } else {
+            terminal.clearScrollback()
+        }
+
+        #expect(buffer.lines.count == terminal.rows)
+        #expect(buffer.lines.maxLength == terminal.rows)
+        #expect(oldestRow == nil)
+        #expect(terminal.getCharacter(col: 0, row: terminal.rows - 1) == "v")
+
+        terminal.feed(text: "\r\nregrown")
+        #expect(buffer.yBase == 1)
+        #expect(buffer.scrollback == -1)
+    }
+}
